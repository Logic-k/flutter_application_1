rules_version = '2';

// ============================================================================
// MemoryLink Firestore 보안 규칙
// ============================================================================
//
// 전제 조건
//   앱은 시작 시 signInAnonymously()로 익명 세션을 만든다 (AuthService).
//   사용자 계정 자체는 로컬 SQLite이며, request.auth.uid 는 "기기(설치) 단위"
//   식별자다. 소유권 필드(authorUid/ownerUid)는 쓰기 시 클라이언트가 기록한다.
//
//   배포 전 Firebase 콘솔에서 Authentication > Anonymous 로그인 활성화 필수.
//
//   관리자 쓰기(notices/faqs 등록, 문의 답변)는 Custom Claims(admin=true)가
//   있어야 허용된다. Claims 부여 체계(Cloud Functions/Admin SDK) 도입 전까지
//   운영 콘텐츠는 Firebase 콘솔에서 직접 등록한다.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 공통 헬퍼 ────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      // Custom Claim 기반 관리자 판별 (Cloud Functions 로 부여)
      return isSignedIn() && request.auth.token.admin == true;
    }

    // ── 공지사항: 로그인 사용자 읽기, 관리자만 쓰기 ───────────────
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── FAQ: 로그인 사용자 읽기, 관리자만 쓰기 ────────────────────
    match /faqs/{faqId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── 1:1 문의: 본인 생성·조회, 관리자 조회·답변 ────────────────
    //   문서에 authorUid 필드를 저장하여 소유권을 판별한다.
    match /inquiries/{inquiryId} {
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow read, update: if isAdmin()
        || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow delete: if isAdmin();

      match /replies/{replyId} {
        allow read: if isAdmin()
          || (isSignedIn()
              && get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.authorUid == request.auth.uid);
        allow write: if isAdmin();
      }
    }

    // ── 보호자 열람 문서 ─────────────────────────────────────────
    //   문서 ID = 암호학적 난수 토큰. 토큰을 아는 보호자만 읽을 수 있다.
    //   (토큰 자체가 비밀 자격 증명 역할)
    //   쓰기는 본인 앱(uid 소유)만 허용한다.
    match /guardian_views/{token} {
      // 토큰(문서 ID)을 알아야만 단일 문서 조회 가능 = 사실상 비밀키.
      // list를 열면 토큰 열거가 가능해지므로 반드시 get만 허용한다.
      allow get: if true;
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    // ── 소셜 랭킹 통계: 전 사용자 공유 EMA 집계 문서 ──────────────
    //   GuardianSyncService._updateGlobalStats 가 score_stats 단일 문서를
    //   merge 갱신한다. 공유 집계 특성상 서명된 클라이언트 쓰기를 허용한다.
    //   (베타 한계 — 추후 Cloud Functions 집계로 이전 예정)
    match /global_stats/score_stats {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ── 적응형 훈련 난이도: 본인(ownerUid) 문서만 접근 ────────────
    //   문서 ID = "<uid>_<username>" (DifficultyProvider._docId)
    match /training_difficulty/{docId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ── 그 외 모든 경로 기본 차단 ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
