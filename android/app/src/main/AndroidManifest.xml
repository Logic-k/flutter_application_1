<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <!-- 릴리스 빌드 필수: Firebase/Gemini/모델 다운로드 등 모든 네트워크 통신에 필요
         (debug/profile 빌드는 Flutter 툴이 자동 주입하지만 release는 직접 선언해야 함) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Health Connect 걸음 권한(READ/WRITE_STEPS)은 두지 않는다. Android 코드는 Health Connect를
         요청하지 않고, health 플러그인은 iOS 백그라운드에서만 쓴다(LAUNCH_AUDIT P0-09).
         HIGH_SAMPLING_RATE_SENSORS도 두지 않는다. 보행 측정은 100Hz로 200Hz 제한 아래다. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="MemoryLink"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">
        
        <!-- Flutter Background Service: 앱 내부에서만 시작하는 포그라운드 서비스이므로
             외부 컴포넌트에 노출하지 않는다(exported=false). 실기기에서 보행 백그라운드
             수집이 정상 동작하는지 재검증 필요. -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="health"
            android:exported="false"
            tools:replace="android:exported" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- 보호자 링크(memorylink-7af26.web.app/guardian.html)는 브라우저 전용이다.
                 앱에는 이 주소를 여는 화면이 없으므로 App Link intent-filter를 두지 않는다
                 (LAUNCH_AUDIT P0-13). 앱 안 보호자 화면을 만들 때만 경로·토큰 검증과
                 Play 앱 서명 지문을 넣은 assetlinks.json을 함께 추가한다. -->
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Impeller enabled (Flutter 3.41+ deprecated Skia opt-out) -->
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ 패키지 공개 범위: speech_to_text·flutter_tts가 음성 인식·읽기 엔진을
             찾으려면 필요하다(LAUNCH_AUDIT P0-12). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
